<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Waypoint — one thing at a time</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#12161c;
    --surface:#1b212b;
    --surface-2:#232b37;
    --ink:#ece9e2;
    --muted:#8a93a3;
    --gold:#e7b75f;
    --gold-dim:rgba(231,183,95,0.18);
    --current:#6fa3d6;
    --danger:#c9705f;
    --radius:14px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Public Sans', -apple-system, sans-serif;
    min-height:100vh;
    line-height:1.5;
  }
  .wrap{
    max-width:640px;
    margin:0 auto;
    padding:48px 20px 100px;
  }
  header{
    display:flex;
    align-items:baseline;
    justify-content:space-between;
    margin-bottom:36px;
    gap:16px;
    flex-wrap:wrap;
  }
  .wordmark{
    font-family:'Fraunces', serif;
    font-size:26px;
    font-weight:500;
    letter-spacing:-0.01em;
  }
  .wordmark span{ color:var(--muted); font-size:15px; font-family:'Public Sans',sans-serif; display:block; margin-top:2px; font-weight:400;}
  header .actions{ display:flex; gap:8px; }
  button{ font-family:inherit; cursor:pointer; }
  .btn{
    background:var(--surface-2);
    color:var(--ink);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:10px;
    padding:9px 14px;
    font-size:14px;
    font-weight:500;
    transition:background 0.15s ease;
  }
  .btn:hover{ background:#2a3341; }
  .btn-ghost{
    background:none;
    border:1px solid rgba(255,255,255,0.12);
    color:var(--muted);
  }
  .btn-ghost:hover{ color:var(--ink); border-color:rgba(255,255,255,0.25); background:none;}

  select.project-select{
    background:var(--surface-2);
    color:var(--ink);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:10px;
    padding:9px 12px;
    font-size:14px;
    font-family:inherit;
    max-width:220px;
  }

  .project-title{
    font-family:'Fraunces', serif;
    font-size:22px;
    font-weight:500;
    margin:0 0 24px;
    color:var(--ink);
  }

  /* ---- Now card ---- */
  .now-card{
    background:var(--surface);
    border-radius:20px;
    padding:36px 32px;
    border:1px solid rgba(255,255,255,0.06);
    position:relative;
    overflow:hidden;
  }
  .now-label{
    font-size:13px;
    color:var(--current);
    font-weight:600;
    margin-bottom:14px;
    display:flex;
    align-items:center;
    gap:8px;
  }
  .now-label::before{
    content:"";
    width:7px; height:7px; border-radius:50%;
    background:var(--current);
    box-shadow:0 0 0 4px rgba(111,163,214,0.18);
  }
  .now-text{
    font-family:'Fraunces', serif;
    font-size:26px;
    font-weight:500;
    line-height:1.35;
    margin-bottom:28px;
    word-break:break-word;
  }
  .now-actions{ display:flex; gap:10px; flex-wrap:wrap; }
  .btn-done{
    background:var(--gold);
    color:#241a08;
    border:none;
    border-radius:12px;
    padding:13px 22px;
    font-size:15px;
    font-weight:700;
    transition:transform 0.1s ease, box-shadow 0.15s ease;
  }
  .btn-done:hover{ box-shadow:0 4px 18px rgba(231,183,95,0.35); }
  .btn-done:active{ transform:scale(0.97); }
  .btn-skip{
    background:none;
    border:none;
    color:var(--muted);
    font-size:14px;
    padding:13px 10px;
  }
  .btn-skip:hover{ color:var(--ink); }

  .affirm{
    position:absolute;
    top:16px; right:20px;
    font-size:13px;
    color:var(--gold);
    font-weight:600;
    opacity:0;
    transform:translateY(-6px);
  }
  .affirm.show{
    animation:pop 1.8s ease forwards;
  }
  @keyframes pop{
    0%{opacity:0; transform:translateY(-6px);}
    15%{opacity:1; transform:translateY(0);}
    80%{opacity:1;}
    100%{opacity:0; transform:translateY(-4px);}
  }

  /* ---- Trail ---- */
  .trail-section{ margin-top:28px; }
  .trail-row{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:10px;
  }
  .dot{
    width:14px; height:14px;
    border-radius:50%;
    background:transparent;
    border:2px solid rgba(255,255,255,0.15);
    flex-shrink:0;
  }
  .dot.done{ background:var(--gold); border-color:var(--gold); }
  .dot.current{
    border-color:var(--current);
    box-shadow:0 0 0 4px rgba(111,163,214,0.18);
  }
  .progress-text{ color:var(--muted); font-size:14px; }

  /* ---- Full list toggle ---- */
  .toggle-all{
    background:none; border:none; color:var(--muted);
    font-size:14px; padding:6px 0; margin-top:18px;
    display:flex; align-items:center; gap:6px;
  }
  .toggle-all:hover{ color:var(--ink); }
  .caret{ transition:transform 0.15s ease; display:inline-block; }
  .caret.open{ transform:rotate(90deg); }

  .chunk-list{
    display:none;
    margin-top:14px;
    border-top:1px solid rgba(255,255,255,0.07);
    padding-top:14px;
  }
  .chunk-list.open{ display:block; }
  .chunk-item{
    display:flex;
    align-items:center;
    gap:12px;
    padding:10px 4px;
    border-radius:10px;
  }
  .chunk-item:hover{ background:var(--surface-2); }
  .chunk-check{
    width:20px; height:20px;
    border-radius:6px;
    border:2px solid rgba(255,255,255,0.2);
    flex-shrink:0;
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    font-size:13px;
    color:transparent;
  }
  .chunk-check.done{ background:var(--gold); border-color:var(--gold); color:#241a08; }
  .chunk-item-text{
    flex:1;
    font-size:15px;
    cursor:pointer;
  }
  .chunk-item.is-current .chunk-item-text{ color:var(--current); font-weight:600; }
  .chunk-item.is-done .chunk-item-text{ color:var(--muted); text-decoration:line-through; }
  .chunk-del{
    background:none; border:none; color:var(--muted);
    font-size:13px; opacity:0; padding:4px 6px;
  }
  .chunk-item:hover .chunk-del{ opacity:1; }
  .chunk-del:hover{ color:var(--danger); }

  .add-chunk-row{
    display:flex; gap:8px; margin-top:14px;
  }
  .add-chunk-row input{
    flex:1;
    background:var(--surface-2);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:10px;
    padding:10px 12px;
    color:var(--ink);
    font-family:inherit;
    font-size:14px;
  }
  .add-chunk-row input:focus{ outline:1px solid var(--current); }

  /* ---- Empty / complete states ---- */
  .empty-state, .complete-state{
    text-align:center;
    padding:20px 10px;
  }
  .empty-state p, .complete-state p{ color:var(--muted); margin:6px 0 20px; font-size:15px; }
  .complete-state .now-text{ color:var(--gold); }

  /* ---- New project form ---- */
  .modal-backdrop{
    display:none;
    position:fixed; inset:0;
    background:rgba(0,0,0,0.55);
    align-items:center; justify-content:center;
    padding:20px;
    z-index:10;
  }
  .modal-backdrop.open{ display:flex; }
  .modal{
    background:var(--surface);
    border-radius:18px;
    padding:28px;
    max-width:480px;
    width:100%;
    border:1px solid rgba(255,255,255,0.08);
  }
  .modal h2{
    font-family:'Fraunces', serif;
    font-weight:500;
    font-size:21px;
    margin:0 0 6px;
  }
  .modal p.hint{ color:var(--muted); font-size:14px; margin:0 0 18px; }
  .modal label{ font-size:13px; color:var(--muted); display:block; margin-bottom:6px; }
  .modal input[type=text]{
    width:100%;
    background:var(--surface-2);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:10px;
    padding:11px 12px;
    color:var(--ink);
    font-family:inherit;
    font-size:15px;
    margin-bottom:16px;
  }
  .modal textarea{
    width:100%;
    min-height:140px;
    background:var(--surface-2);
    border:1px solid rgba(255,255,255,0.08);
    border-radius:10px;
    padding:11px 12px;
    color:var(--ink);
    font-family:inherit;
    font-size:14px;
    resize:vertical;
    margin-bottom:6px;
  }
  .modal .textarea-hint{ font-size:12.5px; color:var(--muted); margin-bottom:18px; }
  .modal-actions{ display:flex; justify-content:flex-end; gap:10px; margin-top:6px; }

  ::selection{ background:var(--gold-dim); }

  @media (prefers-reduced-motion: reduce){
    .affirm.show{ animation:none; opacity:1; }
  }
</style>
</head>
<body>

<div class="wrap">
  <header>
    <div class="wordmark">Waypoint<span>One chunk at a time.</span></div>
    <div class="actions">
      <select class="project-select" id="projectSelect"></select>
      <button class="btn" id="newProjectBtn">+ New project</button>
    </div>
  </header>

  <div id="app"></div>
</div>

<div class="modal-backdrop" id="modalBackdrop">
  <div class="modal">
    <h2>Break something down</h2>
    <p class="hint">Give it a name, then list the pieces — however small. You can always add or edit more later.</p>
    <label for="projName">Project name</label>
    <input type="text" id="projName" placeholder="e.g. Redesign portfolio site">
    <label for="projChunks">Chunks — one per line</label>
    <textarea id="projChunks" placeholder="Write the homepage headline&#10;Pick a font pairing&#10;Export 3 photos&#10;Draft the About paragraph"></textarea>
    <div class="textarea-hint">Smaller is better. If a line still feels big, it's probably two chunks.</div>
    <div class="modal-actions">
      <button class="btn btn-ghost" id="cancelModal">Cancel</button>
      <button class="btn" id="createProject" style="background:var(--gold);color:#241a08;font-weight:700;">Create project</button>
    </div>
  </div>
</div>

<script>
const STORAGE_KEY = 'waypoint_projects_v1';
const AFFIRMATIONS = [
  "That's one done.",
  "Momentum.",
  "Nice — keep going.",
  "One less thing.",
  "That counts.",
  "Progress, logged.",
  "Good. Next.",
];

function load(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : { projects: [], activeId: null };
  }catch(e){
    return { projects: [], activeId: null };
  }
}
function save(state){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
  catch(e){ console.error('Could not save', e); }
}

let state = load();

function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

function getActiveProject(){
  return state.projects.find(p => p.id === state.activeId) || null;
}

function render(){
  renderProjectSelect();
  const app = document.getElementById('app');
  const project = getActiveProject();

  if(!project){
    app.innerHTML = `
      <div class="now-card empty-state">
        <p style="font-family:'Fraunces',serif;font-size:20px;color:var(--ink);margin-bottom:8px;">No project yet</p>
        <p>Start one, and break it into pieces small enough to not feel like anything.</p>
        <button class="btn" id="emptyNewBtn" style="background:var(--gold);color:#241a08;font-weight:700;">+ New project</button>
      </div>`;
    document.getElementById('emptyNewBtn').onclick = openModal;
    return;
  }

  const chunks = project.chunks;
  const doneCount = chunks.filter(c => c.done).length;
  const total = chunks.length;
  const currentIndex = chunks.findIndex(c => !c.done);
  const allDone = total > 0 && currentIndex === -1;

  let html = `<h1 class="project-title">${escapeHtml(project.name)}</h1>`;

  if(total === 0){
    html += `
      <div class="now-card empty-state">
        <p style="font-family:'Fraunces',serif;font-size:20px;color:var(--ink);margin-bottom:8px;">No chunks yet</p>
        <p>Add the first small piece below.</p>
      </div>
      <div class="add-chunk-row" style="margin-top:20px;">
        <input type="text" id="quickAdd" placeholder="Add a chunk...">
        <button class="btn" id="quickAddBtn">Add</button>
      </div>`;
  } else if(allDone){
    html += `
      <div class="now-card complete-state">
        <div class="now-label" style="justify-content:center;color:var(--gold);"><span style="width:7px;height:7px;border-radius:50%;background:var(--gold);display:inline-block;"></span> Project complete</div>
        <div class="now-text">Every piece of this is done.</div>
        <div class="now-actions" style="justify-content:center;">
          <button class="btn" id="addMoreBtn">Add another chunk</button>
          <button class="btn btn-ghost" id="archiveBtn">Start a new project</button>
        </div>
      </div>
      <div class="trail-section">
        <div class="trail-row">${chunks.map(()=>`<div class="dot done"></div>`).join('')}</div>
        <div class="progress-text">${total} of ${total} done</div>
      </div>`;
  } else {
    const current = chunks[currentIndex];
    html += `
      <div class="now-card">
        <span class="affirm" id="affirm"></span>
        <div class="now-label">Now</div>
        <div class="now-text">${escapeHtml(current.text)}</div>
        <div class="now-actions">
          <button class="btn-done" id="doneBtn">Done — next one</button>
          <button class="btn-skip" id="skipBtn">Skip for now</button>
        </div>
      </div>
      <div class="trail-section">
        <div class="trail-row">
          ${chunks.map((c,i) => `<div class="dot ${c.done ? 'done' : (i===currentIndex ? 'current' : '')}"></div>`).join('')}
        </div>
        <div class="progress-text">${doneCount} of ${total} done</div>
      </div>`;
  }

  html += `
    <button class="toggle-all" id="toggleAll"><span class="caret" id="caret">›</span> Show all chunks</button>
    <div class="chunk-list" id="chunkList">
      ${chunks.map((c,i) => `
        <div class="chunk-item ${c.done ? 'is-done':''} ${(!c.done && i===currentIndex) ? 'is-current':''}" data-id="${c.id}">
          <div class="chunk-check ${c.done?'done':''}" data-toggle="${c.id}">${c.done ? '✓' : ''}</div>
          <div class="chunk-item-text" data-jump="${c.id}">${escapeHtml(c.text)}</div>
          <button class="chunk-del" data-del="${c.id}">Remove</button>
        </div>
      `).join('')}
      <div class="add-chunk-row">
        <input type="text" id="quickAdd2" placeholder="Add another chunk...">
        <button class="btn" id="quickAddBtn2">Add</button>
      </div>
    </div>`;

  app.innerHTML = html;
  attachHandlers(project);
}

function renderProjectSelect(){
  const sel = document.getElementById('projectSelect');
  if(state.projects.length === 0){
    sel.innerHTML = `<option value="">No projects</option>`;
    sel.value = "";
    return;
  }
  sel.innerHTML = state.projects.map(p => {
    const done = p.chunks.filter(c=>c.done).length;
    return `<option value="${p.id}">${escapeHtml(p.name)} (${done}/${p.chunks.length})</option>`;
  }).join('');
  sel.value = state.activeId || "";
}

function attachHandlers(project){
  const doneBtn = document.getElementById('doneBtn');
  if(doneBtn){
    doneBtn.onclick = () => {
      const chunks = project.chunks;
      const idx = chunks.findIndex(c => !c.done);
      if(idx > -1){
        chunks[idx].done = true;
        save(state);
        render();
        setTimeout(() => {
          const a = document.getElementById('affirm');
          if(a){
            a.textContent = AFFIRMATIONS[Math.floor(Math.random()*AFFIRMATIONS.length)];
            a.classList.add('show');
          }
        }, 30);
      }
    };
  }
  const skipBtn = document.getElementById('skipBtn');
  if(skipBtn){
    skipBtn.onclick = () => {
      const chunks = project.chunks;
      const idx = chunks.findIndex(c => !c.done);
      if(idx > -1 && idx < chunks.length - 1){
        const [item] = chunks.splice(idx, 1);
        chunks.push(item);
        save(state);
        render();
      }
    };
  }

  const toggleAll = document.getElementById('toggleAll');
  if(toggleAll){
    toggleAll.onclick = () => {
      document.getElementById('chunkList').classList.toggle('open');
      document.getElementById('caret').classList.toggle('open');
      const isOpen = document.getElementById('chunkList').classList.contains('open');
      toggleAll.childNodes[toggleAll.childNodes.length-1].textContent = isOpen ? ' Hide all chunks' : ' Show all chunks';
    };
  }

  document.querySelectorAll('[data-toggle]').forEach(el => {
    el.onclick = () => {
      const id = el.getAttribute('data-toggle');
      const c = project.chunks.find(c => c.id === id);
      if(c){ c.done = !c.done; save(state); render(); document.getElementById('chunkList')?.classList.add('open'); document.getElementById('caret')?.classList.add('open'); }
    };
  });
  document.querySelectorAll('[data-jump]').forEach(el => {
    el.onclick = () => {
      const id = el.getAttribute('data-jump');
      const idx = project.chunks.findIndex(c => c.id === id);
      if(idx > -1){
        const [item] = project.chunks.splice(idx,1);
        const firstUndone = project.chunks.findIndex(c=>!c.done);
        if(firstUndone === -1) project.chunks.push(item);
        else project.chunks.splice(firstUndone,0,item);
        save(state); render();
      }
    };
  });
  document.querySelectorAll('[data-del]').forEach(el => {
    el.onclick = (e) => {
      e.stopPropagation();
      const id = el.getAttribute('data-del');
      project.chunks = project.chunks.filter(c => c.id !== id);
      save(state); render();
      document.getElementById('chunkList')?.classList.add('open');
      document.getElementById('caret')?.classList.add('open');
    };
  });

  ['quickAdd','quickAdd2'].forEach((id, i) => {
    const input = document.getElementById(id);
    const btnId = i === 0 ? 'quickAddBtn' : 'quickAddBtn2';
    const btn = document.getElementById(btnId);
    if(input && btn){
      const addIt = () => {
        const val = input.value.trim();
        if(val){
          project.chunks.push({ id: uid(), text: val, done: false });
          save(state);
          render();
          document.getElementById('chunkList')?.classList.add('open');
          document.getElementById('caret')?.classList.add('open');
        }
      };
      btn.onclick = addIt;
      input.onkeydown = (e) => { if(e.key === 'Enter') addIt(); };
    }
  });

  const addMoreBtn = document.getElementById('addMoreBtn');
  if(addMoreBtn){
    addMoreBtn.onclick = () => {
      const text = prompt('New chunk:');
      if(text && text.trim()){
        project.chunks.push({ id: uid(), text: text.trim(), done: false });
        save(state); render();
      }
    };
  }
  const archiveBtn = document.getElementById('archiveBtn');
  if(archiveBtn){ archiveBtn.onclick = openModal; }
}

function escapeHtml(str){
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

// Modal
function openModal(){
  document.getElementById('modalBackdrop').classList.add('open');
  document.getElementById('projName').value = '';
  document.getElementById('projChunks').value = '';
  document.getElementById('projName').focus();
}
function closeModal(){
  document.getElementById('modalBackdrop').classList.remove('open');
}
document.getElementById('newProjectBtn').onclick = openModal;
document.getElementById('cancelModal').onclick = closeModal;
document.getElementById('modalBackdrop').addEventListener('click', (e) => {
  if(e.target.id === 'modalBackdrop') closeModal();
});
document.getElementById('createProject').onclick = () => {
  const name = document.getElementById('projName').value.trim() || 'Untitled project';
  const lines = document.getElementById('projChunks').value.split('\n').map(l => l.trim()).filter(Boolean);
  const project = {
    id: uid(),
    name,
    chunks: lines.map(text => ({ id: uid(), text, done: false }))
  };
  state.projects.push(project);
  state.activeId = project.id;
  save(state);
  closeModal();
  render();
};

document.getElementById('projectSelect').onchange = (e) => {
  state.activeId = e.target.value;
  save(state);
  render();
};

render();
</script>
</body>
</html>
