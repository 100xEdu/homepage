<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Focus Chunking Dashboard</title>
  <style>
    :root {
      --bg: #0f172a;
      --card: #1e293b;
      --accent: #10b981;
      --text: #f8fafc;
      --text-sub: #94a3b8;
      --border: #334155;
    }
    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      max-width: 640px;
      margin: 40px auto;
      padding: 0 20px;
    }
    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      box-shadow: 0 10px 25px -5px rgba(0,0,0,0.3);
    }
    h1 { font-size: 1.4rem; margin-top: 0; color: var(--accent); }
    .progress-bar {
      height: 10px;
      background: var(--border);
      border-radius: 5px;
      overflow: hidden;
      margin: 16px 0;
    }
    .progress-fill {
      height: 100%;
      background: var(--accent);
      width: 0%;
      transition: width 0.3s ease;
    }
    .focus-box {
      background: #0284c715;
      border: 1px solid #0284c750;
      border-radius: 8px;
      padding: 16px;
      margin: 20px 0;
    }
    .focus-label { font-size: 0.75rem; text-transform: uppercase; color: #38bdf8; letter-spacing: 0.05em; font-weight: 700; }
    .focus-task { font-size: 1.2rem; font-weight: 600; margin-top: 4px; }
    .input-group { display: flex; gap: 8px; margin-bottom: 20px; }
    input[type="text"] {
      flex: 1;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 6px;
    }
    button {
      background: var(--accent);
      color: #000;
      font-weight: 600;
      border: none;
      padding: 10px 16px;
      border-radius: 6px;
      cursor: pointer;
    }
    ul { list-style: none; padding: 0; margin: 0; }
    li {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--border);
    }
    li.done span { text-decoration: line-through; color: var(--text-sub); }
  </style>
</head>
<body>
  <div class="card">
    <h1>⚡ Momentum Chunker</h1>
    <p style="color: var(--text-sub); font-size: 0.9rem;">Break large tasks into tiny actions. Focus on one at a time.</p>
    
    <div class="progress-bar"><div class="progress-fill" id="progress"></div></div>
    
    <div class="focus-box">
      <div class="focus-label">Current Micro-Action</div>
      <div class="focus-task" id="currentTask">Add a step below to begin</div>
    </div>

    <form class="input-group" id="taskForm">
      <input type="text" id="taskInput" placeholder="Add a 2-minute step..." required />
      <button type="submit">Add Step</button>
    </form>

    <ul id="taskList"></ul>
  </div>

  <script>
    let tasks = JSON.parse(localStorage.getItem('adhd_tasks') || '[]');

    function saveAndRender() {
      localStorage.setItem('adhd_tasks', JSON.stringify(tasks));
      const list = document.getElementById('taskList');
      const progress = document.getElementById('progress');
      const currentTask = document.getElementById('currentTask');
      
      list.innerHTML = '';
      const active = tasks.filter(t => !t.done);
      const completed = tasks.filter(t => t.done);
      
      currentTask.textContent = active.length > 0 ? active[0].text : "🎉 All clear! Add your next micro-step.";
      
      const pct = tasks.length ? (completed.length / tasks.length) * 100 : 0;
      progress.style.width = pct + '%';

      tasks.forEach((task, index) => {
        const li = document.createElement('li');
        if (task.done) li.classList.add('done');
        
        const check = document.createElement('input');
        check.type = 'checkbox';
        check.checked = task.done;
        check.onclick = () => { tasks[index].done = !tasks[index].done; saveAndRender(); };

        const span = document.createElement('span');
        span.textContent = task.text;

        li.appendChild(check);
        li.appendChild(span);
        list.appendChild(li);
      });
    }

    document.getElementById('taskForm').onsubmit = (e) => {
      e.preventDefault();
      const input = document.getElementById('taskInput');
      if (input.value.trim()) {
        tasks.push({ text: input.value.trim(), done: false });
        input.value = '';
        saveAndRender();
      }
    };

    saveAndRender();
  </script>
</body>
</html>
